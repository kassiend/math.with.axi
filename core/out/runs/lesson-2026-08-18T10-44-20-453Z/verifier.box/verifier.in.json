  "method_name": "Flip the percent",
  "applicability": "Any 'a% of b' with real a and b: a% of b = b% of a exactly, for every pair, because both equal a*b/100. It is a shortcut whenever one side is the friendlier number to take a percent of. It applies to 'of' only, not to 'a% off b'.",
  "carry_case": "The swap holds for 'of' but not for 'off': 20% off 50 = 40 while 50% off 20 = 10. In general a% off b = b% off a only when a = b.",
  "steps": [
    {
      "step_id": "s1",
      "purpose": "pose",
      "instruction": "Flip the percent",
      "working": "3% of 125 = ?"
    },
    {
      "step_id": "s2",
      "purpose": "rule",
      "instruction": "Swap the two numbers",
      "working": "a% of b = b% of a"
    },
    {
      "step_id": "s3",
      "purpose": "apply",
      "instruction": "Do the easy side",
      "working": "125% of 3 = 3 + 0.75"
    },
    {
      "step_id": "s4",
      "purpose": "result",
      "instruction": "Read it back",
      "working": "3% of 125 = 3.75"
    },
    {
      "step_id": "s5",
      "purpose": "caveat",
      "instruction": "“off” is not “of”",
      "working": "20% off 50 = 40, 50% off 20 = 10"
    }
  ],
