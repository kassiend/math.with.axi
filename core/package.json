{
  "name": "math-with-axi-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "math.with.axi — automated short-form mathematics video pipeline",
  "scripts": {
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts",
    "video:studio": "remotion studio video/index.ts",
    "video:render": "remotion render video/index.ts Lesson out/renders/lesson.mp4",
    "pipeline": "node pipeline/orchestrate.mjs",
    "probe:assets": "node tools/probe-assets.mjs",
    "chromakey": "node tools/chromakey.mjs",
    "sync:agents": "node tools/sync-agents.mjs",
    "sync:backgrounds": "node tools/sync-backgrounds.mjs",
    "smoke": "node tools/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "verify:env": "node tools/verify-env.mjs",
    "worker": "node worker/index.mjs",
    "setup": "node tools/setup.mjs",
    "setup:check": "node tools/setup.mjs --check",
    "sync:skills": "node tools/sync-skills.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@remotion/cli": "^4.0.512",
    "@remotion/media-utils": "^4.0.512",
    "@remotion/player": "^4.0.512",
    "katex": "^0.18.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.512",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.62.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
