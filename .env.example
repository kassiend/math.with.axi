# Copy to .env and fill in. .env is gitignored and must never be committed.
#
# Rotate any key that has been pasted into a chat, a ticket, or a shared terminal.
# A key that has been seen is a key that is spent.

# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=xB7ZTAdAjd7cI20IXiAL

# eleven_v3 supports inline emotion tags ([excited], [pause], ...) but returns no character
# timestamps. eleven_multilingual_v2 is the reverse. The lesson pipeline syncs by per-step clip
# duration, so it does not need timestamps.
ELEVENLABS_MODEL=eleven_v3
