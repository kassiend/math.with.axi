# TEMPLATE ONLY — this file IS tracked by git. Never put a real value in it.
# Copy it to .env (gitignored) and fill the values in there.
#
# Rotate any key that has been pasted into a chat, a ticket, or a shared terminal.
# A key that has been seen is a key that is spent.

# --- ElevenLabs -------------------------------------------------------------
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=xB7ZTAdAjd7cI20IXiAL

# eleven_v3 supports inline emotion tags ([excited], [pause], ...) but returns no character
# timestamps. eleven_multilingual_v2 is the reverse. The lesson pipeline syncs by per-step clip
# duration, so it does not need timestamps.
ELEVENLABS_MODEL=eleven_v3

# --- Telegram delivery ------------------------------------------------------
# From @BotFather. A bot token is a broadcast capability: anyone holding it can post as the bot
# to every chat it is in. Treat it exactly like a password.
TELEGRAM_BOT_TOKEN=

# Written automatically by `npm run worker -- pair`. This is the ONLY chat the worker sends to,
# and it also refuses any chat whose type is not "private" — so a group the bot gets added to
# cannot receive posts.
TELEGRAM_OWNER_CHAT_ID=

# --- Gemini image generation ------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Price per generated image, published Aug 2026. Any of these work — the tool picks the right
# endpoint automatically (Imagen uses :predict, Gemini uses :generateContent).
#
#   imagen-4.0-fast-generate-001    $0.020   cheapest; strong on photoreal scenes
#   gemini-3.1-flash-lite-image     $0.0336  newest cheap tier
#   gemini-2.5-flash-image          $0.039   DEFAULT — proven, best instruction-following
#   imagen-4.0-generate-001         $0.040
#   gemini-3.1-flash-image          $0.067
#   imagen-4.0-ultra-generate-001   $0.060
#   gemini-3-pro-image              $0.134   overkill for a 350x294 card slot
#
# The card shows images at 350x294 design px (525x441 rendered), so nothing above 1K resolution
# buys anything visible here.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# --- Worker schedule --------------------------------------------------------
# Local time, 24h. Local rather than UTC so it lands in your morning wherever you are.
WORKER_DAILY_AT=09:00

# Attempts per post before giving up on it for the day. A closed gate is a normal outcome —
# the ledger records it and the retry picks a different topic.
WORKER_MAX_ATTEMPTS=3

# Which posts a daily run produces, in order.
WORKER_POSTS=lesson,task20,task40
